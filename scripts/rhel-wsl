#!/usr/bin/env bash
# rhel-wsl — tiny helper + boot splash for RHEL on WSL2
set -u

VERSION="0.1.0"

gold=$'\033[38;2;255;211;78m'
blue=$'\033[38;2;77;163;255m'
dim=$'\033[38;2;154;181;204m'
white=$'\033[97m'
reset=$'\033[0m'
bold=$'\033[1m'

splash() {
    cat <<EOF
${gold}
              .~~~~.
           .~~      ~~.
          ~~   ${white}RHEL${gold}   ~~
           ~~.      .~~
             '~~~~~~'
${white}${bold}   Red Hat Enterprise Linux 10.2${reset}
${blue}   on Windows Subsystem for Linux${reset}
${dim}   community desktop lab · vinberg88${reset}

EOF
}

usage() {
    cat <<EOF
rhel-wsl ${VERSION}

Usage:
  rhel-wsl              show splash
  rhel-wsl splash       show splash
  rhel-wsl doctor       basic WSL / systemd / GUI checks
  rhel-wsl help         this text
EOF
}

doctor() {
    echo "=== OS ==="
    cat /etc/redhat-release 2>/dev/null || echo "not RHEL?"
    echo
    echo "=== PID 1 ==="
    ps -p 1 -o pid,comm,args
    echo
    echo "=== WSL ==="
    grep -qi microsoft /proc/version && echo "WSL: yes" || echo "WSL: no"
    echo
    echo "=== GUI ==="
    printf 'DISPLAY=%s\n' "${DISPLAY:-}"
    printf 'WAYLAND_DISPLAY=%s\n' "${WAYLAND_DISPLAY:-}"
    echo
    echo "=== Audio ==="
    if [[ -S /mnt/wslg/PulseServer ]]; then
        echo "WSLg PulseAudio: OK"
    else
        echo "WSLg PulseAudio: not found"
    fi
}

case "${1:-splash}" in
    splash|"") splash ;;
    doctor)    doctor ;;
    help|-h|--help) usage ;;
    version|--version|-v) echo "rhel-wsl ${VERSION}" ;;
    *) usage; exit 1 ;;
esac
